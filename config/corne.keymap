#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen { zmk,matrix_transform = &five_column_transform; };
};

/ {
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <13 14>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <34 33>;
        };

        shift+command {
            bindings = <&kp LS(LEFT_GUI)>;
            key-positions = <27 28>;
        };

        shift {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <37 40>;
        };

        shfitv2 {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <15 20>;
        };

        enter2 {
            bindings = <&kp ENTER>;
            key-positions = <20 19 21>;
        };

        shif_alt {
            bindings = <&kp LS(RIGHT_ALT)>;
            key-positions = <31 32>;
        };
    };

    behaviors {
        pht: positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <100>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <1>;
        };

        pht100: positional_hold_tap_100 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <120>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <1>;
        };

        pht150: positional_hold_tap_150 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <1>;
        };

        pht160: pht160 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <160>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <1>;
            label = "PHT160";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            label = "Base";
            bindings = <
  &kp Q            &kp W             &kp E     &kp R  &kp T    &kp Y          &kp U                    &kp I        &kp O                  &kp P
  &kp A            &pht160 LSHIFT S  &kp D     &kp F  &kp G    &kp H          &kp J                    &kp K        &pht160 RIGHT_SHIFT L  &kp SEMI
  &pht160 LCTRL Z  &kp X             &kp C     &kp V  &kp B    &kp N          &kp M                    &kp COMMA    &kp DOT                &pht160 RCTRL SLASH
                                     &kp LGUI  &mo 1  &mo 2    &kp BACKSPACE  &pht160 RIGHT_ALT SPACE  &lt 3 ENTER
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            label = "Raise";
            bindings = <
  &kp EXCL  &kp AT     &kp HASH  &kp DLLR  &kp PRCNT                   &kp CARET          &kp AMPS        &kp ASTERISK  &kp LPAR          &kp RPAR
  &trans    &kp LCTRL  &kp LALT  &kp LGUI  &kp NON_US_BACKSLASH        &kp SINGLE_QUOTE   &kp MINUS       &kp EQUAL     &kp LEFT_BRACE    &kp RIGHT_BRACE
  &trans    &trans     &trans    &trans    &kp LS(NON_US_BACKSLASH)    &kp DOUBLE_QUOTES  &kp UNDERSCORE  &kp PLUS      &kp LEFT_BRACKET  &kp RIGHT_BRACKET
                       &trans    &trans    &trans                      &kp RET            &kp BACKSLASH   &kp PIPE
            >;
        };

        layer_3 {
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                  &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                  &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    |BTCLR|     | SPC |   | ENT |     | ALT |

            label = "Lower";
            bindings = <
  &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6    &kp N7    &kp N8    &kp N9     &kp N0
  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans
  &trans        &trans        &trans        &trans        &bootloader     &trans    &trans    &trans    &trans     &trans
                              &bt BT_CLR    &trans        &kp SPACE       &kp RET   &trans    &kp RALT
            >;
        };

        layer_5 {
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                  &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                  &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
