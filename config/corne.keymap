#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt { tapping-term-ms = <3000>; };

/ {
    combos {
        compatible = "zmk,combos";

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <17 18>;
        };

        grave {
            bindings = <&kp NON_US_BACKSLASH>;
            key-positions = <8 3>;
        };

        tide {
            bindings = <&kp LS(NON_US_BACKSLASH)>;
            key-positions = <4 7>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <13 14>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <34 33>;
        };
    };

    behaviors {
        pht: positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <130>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <1>;
        };

        pht150: positional_hold_tap_150 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <130>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            label = "Base";
            bindings = <
&trans  &kp Q              &kp W  &kp E  &kp R  &kp T    &kp Y          &kp U      &kp I      &kp O       &kp P                   &trans
&trans  &kp A              &kp S  &kp D  &kp F  &kp G    &kp H          &kp J      &kp K      &kp L       &kp SEMI                &trans
&trans  &pht LEFT_SHIFT Z  &kp X  &kp C  &kp V  &kp B    &kp N          &kp M      &kp COMMA  &kp PERIOD  &pht RIGHT_SHIFT SLASH  &trans
                                  &mo 5  &mo 1  &mo 3    &kp BACKSPACE  &kp SPACE  &mo 2
            >;
        };

        layer_1 {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            label = "layer1";
            bindings = <
&trans  &kp EXCL  &kp AT     &kp HASH  &kp DLLR      &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTERISK  &kp LPAR        &kp RPAR         &trans
&trans  &trans    &kp LCTRL  &kp LALT  &kp LEFT_GUI  &trans       &trans     &kp MINUS  &kp EQUAL     &kp LEFT_BRACE  &kp RIGHT_BRACE  &trans
&trans  &trans    &trans     &trans    &trans        &trans       &trans     &kp TILDE  &kp GRAVE     &kp SQT         &trans           &trans
                             &trans    &trans        &trans       &trans     &trans     &kp PIPE
            >;
        };

        layer_2 {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    |BTCLR|     | SPC |   | ENT |     | ALT |

            label = "layer2";
            bindings = <
&trans  &kp F1      &kp F2     &kp F3        &kp F4        &kp F5    &kp F6          &kp F7          &kp F8         &kp F9     &kp F10  &trans
&trans  &trans      &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &trans    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW   &kp RIGHT  &trans   &trans
&trans  &kp LSHIFT  &trans     &trans        &trans        &trans    &trans          &trans          &trans         &kp F11    &kp F12  &trans
                               &trans        &trans        &trans    &trans          &trans          &kp BACKSLASH
            >;
        };

        layer_3 {
            label = "layer3";
            bindings = <
&trans  &kp N1  &kp N2     &kp N3        &kp N4        &kp N5         &kp N6  &kp N7  &kp N8  &kp N9            &kp N0             &mo 4
&trans  &trans  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &trans         &trans  &trans  &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans  &trans  &trans     &trans        &trans        &bootloader    &trans  &trans  &trans  &trans            &trans             &trans
                           &trans        &trans        &trans         &trans  &trans  &trans
            >;
        };

        layer_4 {
            label = "layer4";
            bindings = <
&kp TAB     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &bootloader     &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans          &trans           &trans              &trans              &trans    &trans  &trans               &trans               &trans           &trans           &trans
&trans  &trans          &pht150 LCTRL S  &pht150 LEFT_ALT D  &pht150 LEFT_GUI F  &trans    &trans  &pht150 RIGHT_GUI J  &pht150 RIGHT_ALT K  &pht150 RCTRL L  &trans           &trans
&trans  &kp LEFT_SHIFT  &trans           &trans              &trans              &trans    &trans  &trans               &trans               &trans           &kp RIGHT_SHIFT  &trans
                                         &trans              &trans              &trans    &trans  &trans               &trans
            >;
        };
    };
};
