%% Corne (nice!nano v2 + nice!view) — build, flash, daily use, troubleshooting
flowchart TD
    %% ---------- BUILD ----------
    subgraph BUILD["1. Build firmware"]
        EDIT["แก้ config/corne.keymap / corne.conf"] --> WHERE{"build ที่ไหน?"}
        WHERE -->|"ในเครื่อง (ZMK 4ec69cb7, board nice_nano_v2)"| LOCAL["buildzmkl / buildzmkr / buildcorne<br/>→ ~/Downloads/CURRENT.UF2-L / -R"]
        WHERE -->|"CI (ZMK main, board nice_nano//zmk)"| CI["git commit & push<br/>→ GitHub Actions build"]
        CI --> DL["gh run download &lt;run-id&gt;<br/>→ corne_left / corne_right .uf2"]
    end

    %% ---------- FLASH ----------
    subgraph FLASH["2. Flash (ทีละข้าง ซ้ายก่อน)"]
        PLUG["เสียบ USB-C ข้างที่จะ flash"] --> BL{"เข้า bootloader"}
        BL -->|"ซ้าย"| BLL["&mo 2 ค้าง + &mo 4 ค้าง + B"]
        BL -->|"ขวา (ต้องต่อกับซ้ายอยู่)"| BLR["&mo 2 ค้าง + &mo 4 ค้าง + N"]
        BL -->|"ปุ่มใช้ไม่ได้"| RST["แตะ RST-GND 2 ครั้ง<br/>(ต้องเปิดเคส)"]
        BLL --> DRIVE["ไดรฟ์ NICENANO ขึ้น"]
        BLR --> DRIVE
        RST --> DRIVE
        DRIVE --> COPY["cp ไฟล์ .uf2 → /Volumes/NICENANO/CURRENT.UF2<br/>(หรือใช้ flashl / flashr: build + รอไดรฟ์ + copy)"]
        COPY --> REBOOT["บอร์ดรีบูตเอง → ทำอีกข้าง"]
        REBOOT --> SAME["⚠️ สองข้างต้องเป็น firmware จาก build เดียวกัน"]
    end

    LOCAL --> PLUG
    DL --> PLUG

    %% ---------- DAILY USE ----------
    subgraph USE["3. ใช้งานประจำวัน"]
        ON["เปิดสวิตช์ทั้งสองข้าง"] --> TYPE["พิมพ์ได้<br/>(จอขวา: รูป wifi = เชื่อมกับซ้ายแล้ว)"]
        TYPE --> LAYERS["Layers<br/>ซ้าย: &mo 1, &mo 2 · ขวา: lt 3 ENTER (กดค้าง = layer 3, แตะ = Enter)<br/>layer 2 + นิ้วก้อยขวาแถวกลาง → layer 4 (BT / bootloader)"]
        TYPE --> COMBOS["Combos<br/>12+13 สลับภาษา (CAPS) · 16+17+18 Enter<br/>21+22 / 27+28 แท็บก่อน/ถัดไป (Cmd+Shift+[ / ])<br/>0+1 Esc · 10+11 Tab · 18+19 Shift+Tab"]
        TYPE --> IDLE["ไม่กด 15 นาที → idle"]
        IDLE --> SLEEP["ไม่กด 40 นาที → sleep"]
        SLEEP -->|"กดปุ่มใดก็ได้"| TYPE
        TYPE --> BT["layer 4: BT_SEL 0-4 เลือกเครื่อง · BT_CLR ล้าง pairing"]
    end

    SAME --> ON

    %% ---------- TROUBLESHOOT ----------
    subgraph FIX["4. แก้ปัญหา"]
        P1["จอขวาเป็น X (ไม่เชื่อมกับซ้าย)"] --> F1["flash ทั้งสองข้างจาก build เดียวกัน"]
        F1 -->|"ยังเป็น X"| F2["flash settings_reset ทั้งสองข้าง → flash firmware ใหม่<br/>(ต้องเปิด settings_reset ใน build.yaml)"]
        P2["จอซ้ายดับ / ติดครึ่งจอ แต่พิมพ์ได้"] --> F3["hardware: ขาจอหลวม/บัดกรี<br/>ใช้ต่อได้ อาจกลับมาติดเอง"]
        P3["CI build พัง: Invalid BOARD"] --> F4["ZMK main ใช้ nice_nano//zmk<br/>(ในเครื่องยังใช้ nice_nano_v2)"]
    end

    TYPE -.-> P1
    TYPE -.-> P2
    CI -.-> P3
